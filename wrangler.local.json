        "name": "SajuAnalysisWorker",
        "script_name": "destinyworker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "SajuAnalysisWorker"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "R2_BUCKET_NAME": "destiny",
    "R2_PUBLIC_URL": "https://r2.youram.me"
