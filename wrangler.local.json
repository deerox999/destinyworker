{
  "compatibility_date": "2025-07-29",
  "main": "src/index.ts",
  "name": "destinyworker",
  "upload_source_maps": true,
  "limits": {
    "cpu_ms": 30000,
    "memory_mb": 128
  },
  "d1_databases": [
    {
      "database_name": "destiny-local",
      "binding": "DB",
      "database_id": "b9c839c9-2356-4bb9-ab20-46e32a85aa2b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "VIEW_CACHE_KV",
      "id": "f76d441ea2524c58a72e355fb4df71b2",
      "preview_id": "68d8ef3bc1644f2f81cca8b57f842267",
      "experimental_remote": true
    }
  ],
  "ai": {
    "binding": "AI",
    "experimental_remote": true
  },
  "vectorize": [
    {
      "binding": "VECTORIZE_INDEX",
      "index_name": "saju-index",
      "experimental_remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "DESTINY_R2",
      "bucket_name": "destiny",
      "preview_bucket_name": "destiny-dev",
      "experimental_remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "analysis",
        "experimental_remote": true
      }
    ],
    "consumers": [
      {
        "queue": "analysis"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SAJU_ANALYSIS_WORKER",
        "class_name": "SajuAnalysisWorker"
      }
    ],
    "classes": [
      {
        "name": "SajuAnalysisWorker",
        "script_name": "destinyworker"
      }
    ],
    "experimental_remote": true
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "SajuAnalysisWorker"
      ]
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 9393
  }
}